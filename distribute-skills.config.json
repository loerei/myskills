{
  "projectsRoot": "D:\\Projects",
  "excludePatterns": [
    "backup",
    "worktree",
    "myskills"
  ],
  "mattPocockInstall": false,
  "platforms": [
    {
      "name": "gemini",
      "sourceDir": "gemini",
      "baseDir": "~/.gemini",
      "agentsDest": "~/.gemini/AGENTS.md",
      "skillsDir": "~/.gemini/config/skills",
      "syncFiles": [
        "AGENTS.md",
        "subdocs"
      ]
    },
    {
      "name": "claude",
      "sourceDir": "claude",
      "baseDir": "~/.claude",
      "agentsDest": "~/.claude/CLAUDE.md",
      "skillsDir": "~/.claude/skills",
      "syncFiles": [
        "AGENTS.md",
        "subdocs"
      ]
    },
    {
      "name": "cursor",
      "sourceDir": "cursor",
      "baseDir": "~/.cursor",
      "agentsDest": "~/.cursor/rules/AGENTS.md",
      "skillsDir": "~/.cursor/skills",
      "syncFiles": [
        "AGENTS.md",
        "subdocs"
      ]
    }
  ]
}
